config LENOVO_HYPERSCHED
	tristate "Lenovo hyper scheduler"
	depends on SMP && ANDROID_VENDOR_HOOKS && ANDROID_VENDOR_OEM_DATA
	help
	  Lenovo task boosting and UX scheduling extensions built on Android
	  scheduler vendor hooks. Controlled through /proc/lenovo_hyperschedule.

	  To compile this driver as a module, choose M here: the module will be
	  called lenovohyperSched.
