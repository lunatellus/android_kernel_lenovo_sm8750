" Show a tab as 2 spaces wide when displayed
set tabstop=2

" When you press <Tab> in insert mode, insert 2 spaces of indentation
set shiftwidth=2

" Make the <Tab> key insert spaces instead of actual tab characters
set expandtab

" When you hit backspace, treat 2 spaces as one tab
set softtabstop=2
