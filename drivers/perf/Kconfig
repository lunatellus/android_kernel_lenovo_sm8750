# Performance Monitor Drivers
#

menu "Performance monitor support"
	depends on PERF_EVENTS

config QCOM_LLCC_PMU
	tristate "Qualcomm Technologies LLCC PMU"
	depends on ARCH_QCOM && ARM64
	help
	   Provides support for the LLCC performance monitor unit (PMU) in
	   Qualcomm Technologies processors.
	   Adds the LLCC PMU into the perf events subsystem for monitoring
	   LLCC miss events.

config ARM_SMMU_PMU
        tristate "ARM SMMU PMU"
        depends on PERF_EVENTS && ARM64 && ARM_SMMU
          help
          Provides support for the SMMU performance monitor unit (PMU)
          on ARM-based systems.
          Adds the SMMU PMU into the perf events subsystem for
          monitoring SMMU performance events.

config MSM_DWC_PCIE_PMU
	tristate "Synopsys DesignWare PCIe PMU"
	depends on PCI
	help
	  Enable perf support for the Synopsys DesignWare PCIe Performance
	  Monitoring Unit (PMU). This driver exposes per-Root-Port hardware
	  counters for PCIe throughput and error metrics via the Linux perf
	  subsystem. Supported on platforms using DesignWare PCIe IP,
	  including the Alibaba Yitian 710 SoC. Say Y or M here to enable
	  PCIe PMU event monitoring via perf stat/perf record.

endmenu
