menu "Lenovo thermal drivers"

config LENOVO_SYS_TEMP
	tristate "Lenovo virtual thermal zones"
	depends on THERMAL_OF && HQ_SYSFS
	help
	  Registers virtual thermal zones whose temperatures are computed from
	  other thermal zones by a fixed model described in the device tree
	  ("lenovo,sys-temp").

	  To compile this driver as a module, choose M here: the module will be
	  called lenovo_sys_temp.

config LENOVO_THERMAL_CONTROL
	tristate "Lenovo thermal control sysfs node"
	help
	  Creates the /sys/devices/system/cpu/cpu0/thermal/control node used by
	  the Lenovo thermal userspace.

	  To compile this driver as a module, choose M here: the module will be
	  called lenovo_thermal_control.

endmenu
