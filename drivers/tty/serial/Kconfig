# Serial device configuration
#

menu "Serial drivers"
	depends on HAS_IOMEM

comment "Non-8250 serial port support"

config SERIAL_MSM_GENI
    tristate "MSM on-chip GENI HW based serial port support"
    depends on ARCH_QCOM
    depends on QCOM_GENI_SE

config SERIAL_QCOM_GENI_MSM
	tristate "QCOM on-chip GENI based serial port support with SCMI"
	depends on ARCH_QCOM || COMPILE_TEST
	depends on QCOM_GENI_SE_MSM
	select SERIAL_CORE
	help
	  This driver supports GENI serial engine based Serial controller
	  on the Qualcomm Technologies Inc.'s SoCs. If you say yes to this
	  option, support will be included for the built-in Serial
	  interface on the Qualcomm Technologies Inc.'s SoCs.

	  This driver can also be built as a module.  If so, the module
	  will be called qcom_geni_serial_msm.

config SERIAL_PKVM_GENI
	tristate "Protected KVM GENI UART"
	depends on ARM64
	depends on KVM
	select SERIAL_CORE
	help
	  This driver provides UART support for protected KVM (pKVM) at EL2
	  (Exception Level 2) on Qualcomm Technologies Inc. SoCs with GENI
	  serial engines. It enables serial console output from the hypervisor
	  running in protected mode, which is useful for debugging and logging
	  purposes in virtualized environments.

	  If you are using pKVM on Qualcomm platforms and need hypervisor-level
	  UART functionality, say Y or M here.

endmenu
