# Input misc drivers configuration
#

config TOUCHSCREEN_CAP1296
        tristate "touch driver for cap1296"
        help
          The CAP1296 is a multiple channel capacitive touch
          sensor controller. It contains six (6) individual capaci-
          tive touch sensor inputs with programmable sensitivity
          for use in touch sensor applications.


config TOUCHSCREEN_NVT_SPI
	tristate "Novatek NT36xxx SPI touchscreen"
	depends on SPI && HQ_SYSFS && QCOM_PANEL_EVENT_NOTIFIER
	help
	  Say Y here to enable support for the Novatek NT36xxx SPI
	  touchscreen controller used on the Lenovo elden board.

	  To compile this driver as a module, choose M here: the
	  module will be called nvt_36xxx.
